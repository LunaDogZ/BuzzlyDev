# Copy to .env and fill in. `docker compose` reads this file automatically.
# NEVER commit the real .env — it holds the Fernet key that encrypts Airflow
# Connections (which will later hold the Supabase service_role key).

# Must match your host UID or the mounted logs/ dir ends up owned by root.
#   echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Encrypts Connections/Variables at rest. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=

# Signs the internal task-execution JWTs. Any long random string.
#   openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=

# Admin login for the Airflow UI at http://localhost:8081
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
