# Environment Variables Template
# Copy this file to .env and update with your values

# Supabase Configuration
#
# NOTE: This project normally runs in MIXED MODE — frontend local (:8080) → Supabase CLOUD.
# For that, point the two vars below at the cloud project (NOT 127.0.0.1) and use the
# cloud anon key. Get it with:  supabase projects api-keys --project-ref <project-ref>
# (the `anon` row). The anon key is public + RLS-protected, safe in the client bundle.
#
#   VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
#   VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
#
# --- LOCAL Supabase (only if you run `npx supabase start`) -------------------
# These are set automatically by the Supabase CLI for a fully-local stack:
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
# On Vercel/cloud, if you only have the Dashboard "anon" key, use this name (same JWT value):
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Error Logging Configuration
# Set to 'false' to disable error logging (defaults to enabled)
VITE_ENABLE_ERROR_LOGGING="true"

# Backend / Mock API server URL
# The frontend sends API keys here for validation and data ingestion.
# In dev this is the mock-api Express server (port 3001).
VITE_BACKEND_API_URL="http://localhost:3001"

# NOTE: For local development, these values are automatically generated by Supabase CLI
# You don't need to change them unless you're connecting to a remote Supabase instance

# ── Vercel (frontend) ─────────────────────────────────────────────────────────
# 1) Set VITE_SUPABASE_URL + key (publishable OR anon) for every environment you use.
# 2) Set VITE_BACKEND_API_URL to your mock-api URL (https, no trailing slash).
# 3) Redeploy after changing any VITE_* variable (values are baked in at build time).
# Mock API: create a separate Vercel project with Root Directory = mock-api (if monorepo),
# and set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY there for POST /api/connect.
