# Mock API Server — Environment Variables
# Copy this file to mock-api/.env and fill in the values.
# Run: supabase status  (to get SUPABASE_SERVICE_ROLE_KEY for local dev)
#
# Vercel: set the same variables in the mock-api project (Settings → Environment Variables).
# Required for POST /api/connect: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (cloud project).
# Redeploy after changing env. Root URL should return JSON (Buzzly Mock API Server) when healthy.

# ── External API source ───────────────────────────────────────────────
# Where this backend fetches platform data from.
# In dev it points back to our own mock fixture endpoints (localhost:3001).
# On Vercel: omit this — the server uses VERCEL_URL so /api/connect can reach
# GET /facebook/:tenant/ads on the same deployment (localhost does not work in prod).
# Or set explicitly to another host (e.g. real Meta/Google base URL).
EXTERNAL_API_BASE_URL=http://localhost:3001

# ── Supabase (for server-side DB writes, bypasses RLS) ───────────────
SUPABASE_URL=http://127.0.0.1:54321

# Get this from: supabase status  →  "service_role key" (local), or the
# Supabase Dashboard → Settings → API → service_role (cloud). NEVER commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ── Server port (optional, defaults to 3001) ──────────────────────────
# PORT=3001
